server {

    listen 80;
    server_name {{ inventory_hostname }}.{{ host_domain }};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;  # Force HTTPS

   location / {
     proxy_pass http://localhost:{{ apache_custom_port }};
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

    error_page 503 = @maintenance;

    location @maintenance {
        root /etc/nginx/html;
        try_files $uri /503_on.html =503;
    }
}