[Unit]
Description=Service to target insertion of genomics indicators in BIGSdb
After=network.target remote-fs.target nss-lookup.target
User=bigsdb

[Service]
Type=idle
ExecStart=/home/bigsdb/BIGSdb/3.12PythonVenv/bin/python3 /home/bigsdb/BIGSdb/bioit_mongodb_scripts/util_azure/azure_service_bus_consumer.py
Restart=on-success

[Install]
WantedBy=multi-user.target
