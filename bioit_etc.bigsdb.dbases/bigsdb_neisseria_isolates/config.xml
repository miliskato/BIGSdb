<?xml version="1.0" encoding="ISO-8859-1" ?>
<db>
<system
 db="bigsdb_neisseria_isolates"
 dbtype="isolates"
 webroot="/neisseria.html"
 indexpage=""
 view="isolates"
 maindisplay_aliases="yes"
 description="Neisseria isolates"
 locus_superscript_prefix="yes"
 authentication="builtin"
 read_access="public"
 all_plugins="yes"
 tblastx_tagging="yes"
 eav_groups="Gene detection|fas fa-search,galaxy report|fas fa-file-medical-alt,Antibiotic resistance|fas fa-angle-right,Serotyping|fas fa-angle-right"
 field_groups="Curation history|fas fa-history"
 user_projects="yes"
 submissions="yes"
>
</system>
<field type="int" required="yes" length="5" maindisplay="yes" comments="primary key">id</field>
<field type="text" required="yes" length="20" maindisplay="yes" comments="isolate name">isolate</field>
<field type="int" required="yes" length="4" maindisplay="no" group ="Curation history" comments="sender unique name, link to users">sender</field>
<field type="int" required="yes" length="4" maindisplay="no" group ="Curation history" comments="curator who entered data,link to users">curator</field>
<field type="date" required="yes" length="10" maindisplay="no" group ="Curation history" comments="latest analysis date">latest_analysis_date</field>
<field type="date" required="yes" length="10" maindisplay="no" group ="Curation history" comments="date first entered">date_entered</field>
<field type="date" required="yes" length="10" maindisplay="no" group ="Curation history" comments="date last modified">datestamp</field>
<field type="text" required="yes" length="20" maindisplay="no" group ="Curation history" comments="uploader through Galaxy">uploader</field>
</db>
