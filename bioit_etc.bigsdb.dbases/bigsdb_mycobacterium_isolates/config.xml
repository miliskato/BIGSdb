<?xml version="1.0" encoding="ISO-8859-1" ?>
<db>
<system
 db="bigsdb_mycobacterium_isolates"
 dbtype="isolates"
 webroot="/mycobacterium.html"
 indexpage=""
 view="isolates"
 maindisplay_aliases="yes"
 description="Mycobacterium isolates"
 locus_superscript_prefix="yes"
 authentication="builtin"
 read_access="authenticated_users"
 all_plugins="yes"
 microreact_year_field="isolation_date"
 tblastx_tagging="yes"
 eav_groups="Gene detection|fas fa-search,galaxy report|fas fa-file-medical-alt,rMLST identification|fas fa-bacteria,51SNP assay|fas fa-angle-right,AMR detection|fas fa-angle-right,spoligotyping|fas fa-angle-right,snpit|fas fa-angle-right,hsp65|fas fa-angle-right,SNP lineage|fas fa-angle-right,NCBI 16S|fas fa-angle-right"
 field_groups="Curation history|fas fa-history,nominative metadata|fas fa-search"
 user_projects="yes"
 submissions="yes"
 genome_submissions="no"
 show_job_notification_form="no"
>
</system>
<field type="int" required="yes" length="5" maindisplay="yes" comments="primary key">id</field>
<field type="text" required="yes" length="20" maindisplay="yes" comments="isolate name">isolate</field>
<field type="int" required="yes" length="4" maindisplay="no" group ="Curation history" comments="sender unique name, link to users">sender</field>
<field type="int" required="yes" length="4" maindisplay="no" group ="Curation history" comments="curator who entered data,link to users">curator</field>
<field type="date" required="yes" length="10" maindisplay="no" group ="Curation history" comments="latest analysis date">latest_analysis_date</field>
<field type="date" required="yes" length="10" maindisplay="no" group ="Curation history" comments="date first entered">date_entered</field>
<field type="date" required="yes" length="10" maindisplay="no" group ="Curation history" comments="date last modified">datestamp</field>
<field type="text" required="yes" length="20" maindisplay="no" group ="Curation history" comments="uploader through Galaxy">uploader</field>
<field type="text" required="yes" length="20" maindisplay="no" group ="Curation history" comments="validation type">validation_type</field>
<field type="text" required="yes" length="40" maindisplay="no" group ="Curation history" comments="curator that validated this sample">validation_curator</field>
<field type="date" required="yes" length="10" maindisplay="no" group ="Curation history" comments="date of curation">validation_date</field>
</db>
