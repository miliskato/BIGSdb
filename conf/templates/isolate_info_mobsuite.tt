[% # Template file for outputting formatted AMRFinder analysis in the isolate information page. %]
[% IF MOB_suite %]
<h3>MOB-suite</h3>

<div class="scrollable">
<style>
    table.nice {
        text-align: center;
        border-collapse: separate;
    }
    table.nice th, table.nice td {
        padding: 2px 6px; /* Adds padding inside cells (top/bottom, left/right) */
    }
    table.nice td:first-child {
        max-width: 50ch;
        overflow-wrap: anywhere;
    }
    table.nice tr:nth-child(n+3) {
        background: #E4EFF3;
    }
    table.nice tr:nth-child(2n+3) {
        background: #C1E6F3;
    }
</style>

<table class="data nice">
    <tr>
        <th>id</th>
        <th>num. contigs</th>
        <th>size</th>
        <th>GC content</th>
        <th>predicted mobility</th>
        <th>rep type(s)</th>
        <th>relaxase types</th>
    </tr>

    <tr>
        <td colspan="4"><a href="[% MOB_suite.results.report_link %]" target="_blank">Full report</a></td>
    </tr>

    [% FOREACH item IN MOB_suite.results.mob_suite_overview %]
    <tr>
        <td>[% item.id %]</td>
        <td>[% item.num_contigs %]</td>
        <td>[% item.size %]</td>
        <td>[% item.gc %]</td>
        <td>[% item.predicted_mobility %]</td>
        <td>[% item.rep_type(s) %]</td>
        <td>[% item.relaxase_type(s) %]</td>
     </tr>
    [% END %]
</table>
</div>
[% END %]