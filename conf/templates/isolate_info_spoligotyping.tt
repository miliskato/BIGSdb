[% # Template file for outputting formatted snpit analysis results in the isolate information page. %]
[% IF Spoligotyping %]
<h3>Spoligotyping</h3>

<div class="scrollable">
<style>
    table.nice {
        text-align: center;
        border-collapse: separate;
    }
    table.nice th, table.nice td {
        padding: 2px 6px; /* Adds padding inside cells (top/bottom, left/right) */
    }
    table.nice td:first-child {
        max-width: 50ch;
        overflow-wrap: anywhere;
    }
    table.nice tr:nth-child(n+3) {
        background: #E4EFF3;
    }
    table.nice tr:nth-child(2n+3) {
        background: #C1E6F3;
    }
</style>

<table class="data nice">
    <tr>
        <th>Binary</th>
        <th>Octal</th>
        <th>SIT number</th>
        <th>Label</th>
    </tr>

    <tr>
        <td colspan="4"><a href="[% Spoligotyping.results.report_link %]" target="_blank">Full report</a></td>
    </tr>
    <tr>
        <td>[% Spoligotyping.results.spoligotype_binary %]</td>
        <td>[% Spoligotyping.results.spoligotype_octal %]</td>
        <td>[% Spoligotyping.results.sit_number %]</td>
        <td>[% Spoligotyping.results.spoligotype_label %]</td>
     </tr>
</table>
</div>
[% END %]
