[% # Template file for outputting formatted LRE-Finder analysis in the isolate information page. %]

[% IF LRE_Finder %]
<div class="indented-hera">
<h3>LRE-Finder</h3>

<h4>Detected genes</h4>
<div>
<table class="data nice" style="width: 35%;">
    <tr>
        <th>Gene</th>
        <th>Depth</th>
        <th>Template Identity</th>
    </tr>

    <tr>
        <td colspan="3"><a href="[% LRE_Finder.results.report_link %]" target="_blank">Full report</a></td>
    </tr>

    [% FOREACH hit IN LRE_Finder.results.lrefinder_genes %]
    <tr>
        <td>[% hit.Gene %]</td>
        <td>[% hit.Depth %]</td>
        <td>[% hit.Template_identity %]</td>
     </tr>
    [% END %]
</table>
</div>
</div>
[% END %]

[% IF LRE_Finder.results.lrefinder_mutations %]
<div class="indented-hera">
<h4>Detected mutations</h4>
<div>
<table class="data nice" style="width: 35%;">
    <tr>
        <th>Predicted phenotype</th>
        <th>Position in reference</th>
        <th>Wild type ratio (%)</th>
        <th>Mutant type ratio (%)</th>
    </tr>
    [% FOREACH mutation IN LRE_Finder.results.lrefinder_mutations %]
    <tr>
        <td>[% mutation.Predicted_phenotype %]</td>
        <td>[% mutation.Position_in_reference %]</td>
        <td>[% mutation.Wild_type_ratio_percent %]</td>
        <td>[% mutation.Mutant_type_ratio_percent %]</td>
    </tr>
    [% END %]
</table>
</div>
</div>
[% END %]

[% IF LRE_Finder.results.lrefinder_species %]
<div class="indented-hera">
<div>
  <strong style="color: #404080;">LRE-Finder species:</strong> [% LRE_Finder.results.lrefinder_species %]
</div>
</div>
<br>
[% END %]
