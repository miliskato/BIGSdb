[% # Template file for outputting formatted Krona analysis results in the isolate information page. %]
[% IF Krona %]

<div class="indented-hera">
<h3>Krona visualization of kraken2 results</h3>
    <iframe
        src=[% Krona.results.krona_report_url %]
        style="border: none;"
        width="800"
        height="500"
        >
    </iframe>
</div>
<br>
[% END %]