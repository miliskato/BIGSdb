[% # Template file for outputting formatted Nextclade analysis results in the isolate information page. %]
[% IF Nextclade %]


<div class="indented-hera-2">
<h3>Nextclade</h3>

<div class="field_group">
<dl class="data">
    <span class="dontsplit">
    <dt>Influenza subtype</dt><dd>[% Nextclade.results.nextclade_detected_subtype %]</dd>
    </span>
    [% IF Nextclade.results.nextclade_ha_clade %]
        <span class="dontsplit">
        <dt>HA clade</dt><dd>[% Nextclade.results.nextclade_ha_clade %]</dd>
        <dt>HA reference</dt><dd>[% Nextclade.results.nextclade_ha_reference %]</dd>
        </span>
    [% END %]
    [% IF Nextclade.results.nextclade_na_clade %]
        <span class="dontsplit">
        <dt>NA clade</dt><dd>[% Nextclade.results.nextclade_na_clade %]</dd>
        <dt>NA reference</dt><dd>[% Nextclade.results.nextclade_na_reference %]</dd>
        </span>
    [% END %]
</dl>
</div>
</div>
<br>
[% END %]