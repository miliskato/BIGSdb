/**
 * @file
 * Global utilities.
 *
 */

let hasLoadedGlobal = false;
(function($, Drupal) {

  'use strict';

  Drupal.behaviors.pubmlst = {
    attach: function(context, settings) {
      /**
       * this will make the code inside be called only once
       * outside of this is called once for every node on the side
       */
       
       // ---------------- ACTIVE A-Z ---------------- //

       // READ COOKIE
       function readCookie(name) {
         var nameEQ = name + "=";
         var ca = document.cookie.split(';');
         for (var i = 0; i < ca.length; i++) {
           var c = ca[i];
           while (c.charAt(0) == ' ') c = c.substring(1, c.length);
           if (c.indexOf(nameEQ) == 0) var active_a_z_btn = c.substring(nameEQ.length, c.length);
         }
         $('.a-z-filter span a').each(function () {
           if ($(this)[0].getAttribute("href") == active_a_z_btn) {
             $(this).addClass('active');
             // detele the cookie after apply the class
             document.cookie = "a_z_cookie=all;path=/";
             active_a_z_btn = "all";
           } else {
             // console.log('each url= ' + $(this)[0].getAttribute("href"));
           }
         });
         return null;
       }

       // SET COOKIE ON CLICK
       $('.a-z-filter span a').click(function () {
         // createCookie(a_z_cookie,$(this)[0].getAttribute("href"));
         document.cookie = "a_z_cookie=" + $(this)[0].getAttribute("href") + ";path=/";
         // var date = new Date();
         // // // date.setTime(date.getTime()+(days*24*60*60*1000));
         // date.setTime(date.getTime()+(2*1000));
         // var expires = "; expires="+date.toGMTString();
         // document.cookie = "a_z_cookie="+$(this)[0].getAttribute("href")+expires+";path=/";
       });

       // CALL READ COOKIE FNC
       readCookie('a_z_cookie');

       // DELETE COOKIE WITH RESET BTN
       // $('.view-organism-landing .view-filters .button.btn-reset').click(function() {
       //   document.cookie = "a_z_cookie=all;path=/";
       //   active_a_z_btn="all";
       // });
       
       
      if (context === document || (($(context).hasClass('user-logged-in')) && !hasLoadedGlobal)) {
        hasLoadedGlobal = true;

        var position = $(window).scrollTop();
        $(window).scroll(function () {
          if ($(this).scrollTop() > 50) {
            $('body').addClass("scrolled");
          } else {
            $('body').removeClass("scrolled");
          }
          var scroll = $(window).scrollTop();
          if (scroll > position) {
            $('body').addClass("scrolldown");
            $('body').removeClass("scrollup");
          } else {
            $('body').addClass("scrollup");
            $('body').removeClass("scrolldown");
          }
          position = scroll;
        });

        // Flickity options, defaults
        var options = {
          cellAlign: 'left',
          prevNextButtons: false
        };

        // enable prev/next buttons at 768px
        if (matchMedia('screen and (min-width: 768px)').matches) {
          options.prevNextButtons = true;
        }
        if (matchMedia('screen and (min-width: 992px)').matches) {
          options.groupCells = 3;
        }

        $('#tweetsCarousel').flickity(options);

        $(".nav-link.nav-link--user").text('Drupal account');

        // console.log("Test loading");


        


        // ---------------- RESET SEARCH OPTIONS ---------------- //
        let daForm = $(document).find('#views-exposed-form-organism-landing-page');

        if (daForm.length > 0) {
          
          //scroll to the results
          if (location.search.length > 0 && location.search.indexOf('title') > -1) {
            const scrollDiv = document.getElementById("content").offsetTop;
            window.scrollTo({ top: scrollDiv, behavior: 'smooth'});
          }

          //using drupal ajax core functions
          let ajaxBeforeSend = Drupal.Ajax.prototype.beforeSend;
          Drupal.Ajax.prototype.beforeSend = function(jqXHR, settings) {
            
            //ignore title in get parameter (url)
            if (location.search.length > 0 && location.search.indexOf('title') > -1) {
              settings.url = settings.url.replace(location.search.substr(1) + '&', '');
            }

            //remove letter 
            if (settings.data.indexOf('title=') === 0) {
              let regex = /view_args=.\&/gm;
              settings.data = settings.data.replace(regex, '');

              regex = /view_path=\%2Forganisms\%2F\D&/gm;
              const subst = `view_path=\%2Forganisms&`;
              settings.data = settings.data.replace(regex, subst);

              ajaxBeforeSend.call(this, jqXHR, settings);
            }
          }
        }
      }
      
    }
  };

})(jQuery, Drupal);
;
